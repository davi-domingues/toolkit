{
  "name": "@davi-domingues/toolkit",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Personal toolkit of skills, agents, rules and prompts for AI coding agents",
  "type": "module",
  "bin": {
    "toolkit": "bin/toolkit.js"
  },
  "files": [
    "bin",
    "scripts",
    "skills",
    "agents",
    "rules",
    "prompts"
  ],
  "engines": { "node": ">=20" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davi-domingues/toolkit.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "install:tools": "node bin/toolkit.js install",
    "status": "node bin/toolkit.js status",
    "validate": "node bin/toolkit.js validate",
    "test": "node --test"
  }
}
